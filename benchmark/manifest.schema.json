{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://permind.local/mingtu-ai/benchmark-manifest-v1.schema.json",
  "title": "Mingtu AI M0 benchmark manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "model_id": {"type": "string", "minLength": 1, "maxLength": 200},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "cases": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 120}
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "file"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
        },
        "file": {"type": "string", "minLength": 1, "maxLength": 500},
        "expected_terms": {"$ref": "#/$defs/stringList"},
        "expected_stem_tokens": {"$ref": "#/$defs/stringList"},
        "expected_language": {"type": "string", "minLength": 1, "maxLength": 35},
        "expected_category": {"type": "string", "minLength": 1, "maxLength": 80},
        "expected_adapter_kind": {"type": "string", "minLength": 1, "maxLength": 40},
        "manual_scores": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "content_understanding": {"type": "number", "minimum": 0, "maximum": 5},
            "stem_quality": {"type": "number", "minimum": 0, "maximum": 5},
            "filename_searchability": {"type": "number", "minimum": 0, "maximum": 5},
            "ocr_quality": {"type": "number", "minimum": 0, "maximum": 5}
          }
        },
        "manual_notes": {"type": "string", "minLength": 1, "maxLength": 2000},
        "tags": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}
