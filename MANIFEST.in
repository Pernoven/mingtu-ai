include _mingtu_build.py
include pyproject.toml
include setup.py
include README.md
include CONTRIBUTING.md
include SECURITY.md
recursive-include src *.py
recursive-include native *.cpp *.md
recursive-include docs *.md
recursive-include packaging *
recursive-include scripts *.py *.fish
recursive-include tests *.py
recursive-include benchmark *.py *.json *.md *.gitkeep
prune benchmark/results
global-exclude __pycache__ *.py[cod] *.so
