# Copy manually to ~/.config/mingtu-ai/environment and edit before enabling.
# systemd EnvironmentFile values are not shell-expanded.
MINGTU_AI_MODEL=/path/to/gemma-4-E2B-it-qat-q4_0.gguf

# Optional multimodal projector when required by the selected llama.cpp/model build.
# MINGTU_AI_MMPROJ=/path/to/mmproj.gguf

# Optional. Separate multiple absolute paths with a colon on Linux.
# MINGTU_AI_WATCH_DIRS=/path/to/Screenshots:/path/to/Downloads

# Optional when llama-server is not installed at /usr/bin/llama-server.
# MINGTU_AI_LLAMA_SERVER=/path/to/llama-server
